# AUGUR's packages come from GitHub Packages, published as @harry-burton-dev/augur-<name> and aliased
# back to @augur/<name> in package.json. CI sets NODE_AUTH_TOKEN; locally, a token with read:packages.
@harry-burton-dev:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
