  "dependencies": {
    "@augur/mfe-sdk": "workspace:*",
    "@augur/ui-kit": "workspace:*",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "happy-dom": "^20.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.0"
  }
}
